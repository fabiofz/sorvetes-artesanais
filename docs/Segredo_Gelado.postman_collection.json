          "mode": "raw",
          "raw": "{\n  \"canalPedido\": \"WHATSAPP\",\n  \"external_id\": \"{{externalId}}\",\n  \"customer_name\": \"Cliente fictício\",\n  \"customer_contact\": \"000000000\",\n  \"address\": \"Rua demonstrativa, 10\",\n  \"payment_method\": \"PIX\",\n  \"already_paid\": false,\n  \"items\": [\n    {\n      \"offer_id\": \"{{offerId}}\",\n      \"quantity\": 1,\n      \"flavors\": [\n        {\n          \"inventory_id\": \"{{chocolateId}}\",\n          \"balls\": 2\n        },\n        {\n          \"inventory_id\": \"{{morangoId}}\",\n          \"balls\": 1\n        }\n      ],\n      \"packages\": [\n        {\n          \"inventory_id\": \"{{packageId}}\",\n          \"quantity\": 1\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
