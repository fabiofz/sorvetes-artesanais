    {
      "name": "22 - Escalar entregador para hoje",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/shifts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver_id\": \"{{driverId}}\",\n  \"day\": \"{{today}}\",\n  \"working\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const a=new Intl.DateTimeFormat(\"en-US\",{timeZone:\"America/Sao_Paulo\",year:\"numeric\",month:\"2-digit\",day:\"2-digit\"}).formatToParts(new Date()); const g=t=>a.find(x=>x.type===t).value; pm.collectionVariables.set(\"today\",`${g(\"year\")}-${g(\"month\")}-${g(\"day\")}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
