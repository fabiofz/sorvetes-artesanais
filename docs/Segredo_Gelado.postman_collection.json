{
  "info": {
    "name": "Segredo Gelado - fluxo demonstrativo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute em ordem em um banco de demonstração. Requer init-db, seed-demo e administrador criado. Só contém dados fictícios; pagamentos e estornos são mock."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login administrador",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar opções de venda",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/catalog/offers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const x=pm.response.json().find(x=>x.balls===3); pm.expect(x).to.exist; pm.collectionVariables.set(\"offerId\",x.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar sabores e embalagens",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/inventory?limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const a=pm.response.json(); for (const [n,k] of [[\"Chocolate\",\"chocolateId\"],[\"Morango\",\"morangoId\"],[\"Caixinha\",\"packageId\"]]) { const x=a.find(x=>x.name===n); pm.expect(x).to.exist; pm.collectionVariables.set(k,x.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Entrada demonstrativa de estoque",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/inventory/{{chocolateId}}/adjustments",
        "body": {
