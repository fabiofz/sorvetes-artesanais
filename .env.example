# Copie para .env. Substitua usuario, senha, nome do banco e a chave JWT.
DATABASE_URL=mysql+pymysql://segredo:SUA_SENHA@127.0.0.1:3306/segredo_gelado?charset=utf8mb4
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
JWT_MINUTES=30
# Este projeto demonstra pagamentos e estornos; não movimenta dinheiro real.
PAYMENT_MODE=mock
